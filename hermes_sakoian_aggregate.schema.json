{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "tp-astro-analysis.aggregate-result.v2"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^aggregate_[0-9a-f]{24}$"
    },
    "aggregate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "access_scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "chart_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "method_ref": {
      "type": "object",
      "properties": {
        "method_id": {
          "const": "sakoian_transit_analysis"
        },
        "version": {
          "const": "0.3.0"
        },
        "package_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "test_only"
        },
        "knowledge_ref": {
          "type": "object",
          "properties": {
            "environment": {
              "const": "test"
            },
            "family_id": {
              "const": "sakoian_transit_analysis_core"
            },
            "version": {
              "const": "0.3.0"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "knowledge_base_slug": {
              "const": "sakoian-transit-primary-v1"
            }
          },
          "required": [
            "environment",
            "family_id",
            "version",
            "content_hash",
            "knowledge_base_slug"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method_id",
        "version",
        "package_hash",
        "status",
        "knowledge_ref"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "producer": {
          "const": "core_astrogeo"
        },
        "core_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "moment_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "producer",
        "core_commit",
        "request_hash",
        "response_hash",
        "moment_utc"
      ],
      "additionalProperties": false
    },
    "analyses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/single"
      }
    },
    "projection": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "sakoian_structural_groups_v1"
        },
        "groups": {
          "type": "array"
        },
        "unlinked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24
        },
        "shared_facts": {
          "type": "object"
        }
      },
      "required": [
        "profile",
        "groups",
        "unlinked",
        "events",
        "shared_facts"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "selected_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "included_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "partial_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      },
      "required": [
        "selected_count",
        "included_count",
        "omitted_count",
        "partial_count"
      ],
      "additionalProperties": false
    },
    "narrative_catalogue": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "tp-astro-analysis.narrative-catalogue.v1"
        },
        "catalogue_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "analysis_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "basis_fact_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "minItems": 0,
                      "maxItems": 100,
                      "uniqueItems": true
                    },
                    "basis_derivation_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "minItems": 0,
                      "maxItems": 100,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "claim_id",
                    "text",
                    "basis_fact_ids",
                    "basis_derivation_ids"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": [
              "event_ref",
              "analysis_id",
              "claims"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 24
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "enum": [
                  "shared_natal_receiver",
                  "shared_transit_planet",
                  "shared_transit_house"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "event_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 2,
                "maxItems": 24,
                "uniqueItems": true
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "basis_fact_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "minItems": 0,
                      "maxItems": 100,
                      "uniqueItems": true
                    },
                    "basis_derivation_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "minItems": 0,
                      "maxItems": 100,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "claim_id",
                    "text",
                    "basis_fact_ids",
                    "basis_derivation_ids"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": [
              "group_id",
              "kind",
              "key",
              "event_refs",
              "claims"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 36
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "basis_fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              },
              "basis_derivation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "claim_id",
              "text",
              "basis_fact_ids",
              "basis_derivation_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "schema_version",
        "catalogue_hash",
        "events",
        "groups",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "aggregate_id",
    "aggregate_hash",
    "request_id",
    "access_scope_ref",
    "subject_ref",
    "chart_ref",
    "method_ref",
    "source",
    "analyses",
    "projection",
    "coverage",
    "narrative_catalogue"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "single": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "tp-astro-analysis.result.v1"
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "access_scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "chart_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "method_ref": {
          "type": "object",
          "properties": {
            "method_id": {
              "const": "sakoian_transit_analysis"
            },
            "version": {
              "const": "0.3.0"
            },
            "package_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "status": {
              "const": "test_only"
            },
            "knowledge_ref": {
              "type": "object",
              "properties": {
                "environment": {
                  "const": "test"
                },
                "family_id": {
                  "const": "sakoian_transit_analysis_core"
                },
                "version": {
                  "const": "0.3.0"
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "knowledge_base_slug": {
                  "const": "sakoian-transit-primary-v1"
                }
              },
              "required": [
                "environment",
                "family_id",
                "version",
                "content_hash",
                "knowledge_base_slug"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "method_id",
            "version",
            "package_hash",
            "status",
            "knowledge_ref"
          ],
          "additionalProperties": false
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "availability": {
                "type": "string",
                "enum": [
                  "known",
                  "unknown"
                ]
              },
              "value": {},
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true,
                "maxItems": 100
              }
            },
            "required": [
              "fact_id",
              "kind",
              "availability",
              "value",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "derivations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "derivation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "rule_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "basis_fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true,
                "maxItems": 100
              },
              "value": {},
              "priority": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "context",
                  "detail"
                ]
              }
            },
            "required": [
              "derivation_id",
              "rule_ref",
              "basis_fact_ids",
              "value",
              "priority"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "rule_ref": {
                      "const": "sakoian.aspect_nature.v1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "object",
                      "properties": {
                        "aspect_type": {
                          "type": "string",
                          "enum": [
                            "conjunction",
                            "sextile",
                            "square",
                            "trine",
                            "opposition"
                          ]
                        },
                        "nature": {
                          "$ref": "#/$defs/single/$defs/aspect_nature"
                        }
                      },
                      "required": [
                        "aspect_type",
                        "nature"
                      ],
                      "additionalProperties": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "rule_ref": {
                      "const": "sakoian.natal_reinforcement.v1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/single/$defs/natal_reinforcement"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "rule_ref": {
                      "const": "sakoian.primary_synthesis.v1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/single/$defs/primary_synthesis"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 100
        },
        "primary_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "type": "string",
                "enum": [
                  "known",
                  "unknown"
                ]
              },
              "fact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true,
                "maxItems": 100
              },
              "derivation_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true,
                "maxItems": 100
              }
            },
            "required": [
              "order",
              "code",
              "status",
              "fact_refs",
              "derivation_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 5,
          "maxItems": 5
        },
        "natal_pair": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "present",
                "absent",
                "unknown",
                "not_applicable"
              ]
            },
            "aspect_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "conjunction",
                  "sextile",
                  "square",
                  "trine",
                  "opposition"
                ]
              },
              "uniqueItems": true,
              "maxItems": 5
            }
          },
          "required": [
            "status",
            "aspect_types"
          ],
          "additionalProperties": false
        },
        "activation_kind": {
          "type": "string",
          "enum": [
            "same_pair_same_aspect_type",
            "same_pair_different_aspect_type",
            "no_natal_pair",
            "unknown",
            "self_return"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true,
                "maxItems": 100
              }
            },
            "required": [
              "code",
              "message",
              "paths"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "coverage": {
          "type": "object",
          "properties": {
            "profile": {
              "const": "primary"
            },
            "completed_steps": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "uniqueItems": true
            },
            "omitted_steps": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "uniqueItems": true
            }
          },
          "required": [
            "profile",
            "completed_steps",
            "omitted_steps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "analysis_id",
        "request_id",
        "access_scope_ref",
        "subject_ref",
        "chart_ref",
        "method_ref",
        "input_hash",
        "status",
        "facts",
        "derivations",
        "primary_factors",
        "natal_pair",
        "activation_kind",
        "warnings",
        "coverage"
      ],
      "additionalProperties": false,
      "$defs": {
        "aspect_nature": {
          "type": "object",
          "properties": {
            "qualities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true
            },
            "ambivalence": {
              "type": "string",
              "enum": [
                "context_dependent",
                "development_through_friction"
              ]
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "outcome_determined": {
              "const": false
            }
          },
          "required": [
            "qualities",
            "ambivalence",
            "source_ref",
            "outcome_determined"
          ],
          "additionalProperties": false
        },
        "natal_reinforcement": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "tension_reinforced",
                "pair_activated",
                "no_natal_pair",
                "unknown",
                "not_applicable"
              ]
            },
            "natal_aspect_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "conjunction",
                  "sextile",
                  "square",
                  "trine",
                  "opposition"
                ]
              },
              "uniqueItems": true
            },
            "transit_aspect_type": {
              "type": "string",
              "enum": [
                "conjunction",
                "sextile",
                "square",
                "trine",
                "opposition"
              ]
            },
            "source_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis_kind": {
              "enum": [
                "source_example_generalized",
                "source_rule",
                null
              ]
            }
          },
          "required": [
            "status",
            "natal_aspect_types",
            "transit_aspect_type",
            "source_ref",
            "basis_kind"
          ],
          "additionalProperties": false
        },
        "primary_synthesis": {
          "type": "object",
          "properties": {
            "activating_transit_planet": {
              "type": "string",
              "enum": [
                "sun",
                "moon",
                "mercury",
                "venus",
                "mars",
                "jupiter",
                "saturn",
                "uranus",
                "neptune",
                "pluto"
              ]
            },
            "receiving_natal_planet": {
              "type": "string",
              "enum": [
                "sun",
                "moon",
                "mercury",
                "venus",
                "mars",
                "jupiter",
                "saturn",
                "uranus",
                "neptune",
                "pluto"
              ]
            },
            "transit_natal_house": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 12
            },
            "natal_cusp_sign": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "aries",
                    "taurus",
                    "gemini",
                    "cancer",
                    "leo",
                    "virgo",
                    "libra",
                    "scorpio",
                    "sagittarius",
                    "capricorn",
                    "aquarius",
                    "pisces"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "transit_sign": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "aries",
                    "taurus",
                    "gemini",
                    "cancer",
                    "leo",
                    "virgo",
                    "libra",
                    "scorpio",
                    "sagittarius",
                    "capricorn",
                    "aquarius",
                    "pisces"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "aspect": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "conjunction",
