# Copy this file into each separate production Coolify application only after
# its production release is explicitly approved. All CHANGE_ME values are
# runtime-only placeholders and intentionally make the contract non-deployable.

HERMES_FIXED_MODEL_ENABLED=true
HERMES_FIXED_MODEL_REQUIRED=true
HERMES_RUNTIME_TIER=CHANGE_ME_economy_or_balanced_or_strong
HERMES_RUNTIME_ID=CHANGE_ME_unique_production_runtime_id
HERMES_FIXED_MODEL_PROVIDER=openrouter
HERMES_FIXED_MODEL_DEFAULT=CHANGE_ME/openrouter-model-id
HERMES_FIXED_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_FIXED_MODEL_MAX_TOKENS=4096

HERMES_WRAPPER_COMMIT=$SOURCE_COMMIT
HERMES_DEPLOYMENT_ENVIRONMENT=production
HERMES_RELEASE_EVIDENCE_REQUIRED=true

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=9119
API_SERVER_KEY=CHANGE_ME_unique_production_secret_for_this_runtime
OPENROUTER_API_KEY=CHANGE_ME_production_runtime_scoped_openrouter_key
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# This file's runtime must own this unique persistent volume and journal.
HERMES_ACCOUNTING_JOURNAL_PATH=/opt/data/hermes-accounting.sqlite3
HERMES_ACCOUNTING_INTERNAL_TOKEN=CHANGE_ME_unique_production_accounting_token
