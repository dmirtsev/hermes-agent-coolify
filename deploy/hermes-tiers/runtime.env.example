# Copy this template into each separate Coolify application. Values beginning
# with CHANGE_ME are placeholders. Keep all variables runtime-only.

HERMES_FIXED_MODEL_ENABLED=true
HERMES_FIXED_MODEL_REQUIRED=true
HERMES_RUNTIME_TIER=CHANGE_ME_economy_or_balanced_or_strong
HERMES_RUNTIME_ID=CHANGE_ME_unique_runtime_id
HERMES_FIXED_MODEL_PROVIDER=openrouter
HERMES_FIXED_MODEL_DEFAULT=CHANGE_ME/openrouter-model-id
HERMES_FIXED_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_FIXED_MODEL_MAX_TOKENS=4096

HERMES_WRAPPER_COMMIT=$SOURCE_COMMIT
HERMES_DEPLOYMENT_ENVIRONMENT=test
HERMES_RELEASE_EVIDENCE_REQUIRED=true

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=9119
API_SERVER_KEY=CHANGE_ME_unique_secret_for_this_runtime
OPENROUTER_API_KEY=CHANGE_ME_runtime_scoped_openrouter_key
